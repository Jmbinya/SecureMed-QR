SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=securemed

# Redis — required for server-side sessions (flask-session)
# Local dev: run `redis-server` locally, or use a free Redis Docker container
# Railway: add the Redis plugin — it injects REDIS_URL automatically
REDIS_URL=redis://localhost:6379
