SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# Render injects this automatically in production via render.yaml.
# For local dev, point at your local Postgres:
DATABASE_URL=postgresql://postgres:Xavier@localhost:5432/securemed

# Upstash Redis — copy the rediss:// URL from your Upstash dashboard
REDIS_URL=redis://localhost:6379
